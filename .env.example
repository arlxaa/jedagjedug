# Copy this file to .env and fill in your Spotify app's Client ID.
#
# 1. Go to https://developer.spotify.com/dashboard and create an app.
# 2. Add this redirect URI exactly (loopback IP, NOT localhost):
#       http://127.0.0.1:5173/callback
#    For production, add your HTTPS origin + /callback as well.
# 3. Add your own Spotify account under "Users and Access" (dev-mode allowlist).
# 4. Copy the Client ID below. No client secret is needed (PKCE flow).

VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: override the redirect URI if you deploy somewhere else.
# VITE_SPOTIFY_REDIRECT_URI=https://your-domain.example/callback
